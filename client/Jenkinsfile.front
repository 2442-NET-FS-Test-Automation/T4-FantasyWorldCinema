pipeline {
    agent { label 'windows' }

    environment {
        FRONT_DIR = 'client/cinema' 
        
        SAS_TOKEN = credentials('web-sas')
        
        STORAGE_URL = 'https://cinemaclient.blob.core.windows.net/$web'
        
        VITE_API_URL = 'https://cinema-api-g6gqh3gjetehcnfw.centralus-01.azurewebsites.net/api'

        CYPRESS_loginIdentifier = credentials('cy-user')
        CYPRESS_loginPassword = credentials('cy-pass')
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir(env.FRONT_DIR) {
                    bat 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                dir(env.FRONT_DIR) {
                    bat 'npm run build'
                }
            }
        }

        stage('E2E Tests') {
            steps {
                dir(env.FRONT_DIR) {
                    bat 'npm run test:e2e:ci'
                }
            }
        }

        stage('Deploy to Azure Blob') {
            steps {
                dir(env.FRONT_DIR) {
                    bat 'azcopy copy "dist\\*" "%STORAGE_URL%?%SAS_TOKEN%" --recursive=true'
                }
            }
        }
    }
}